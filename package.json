{
  "name": "orbion-ai",
  "productName": "Orbion.ai",
  "version": "0.1.1",
  "description": "App desktop que orquestra agentes de IA (Claude Code, Codex e modelos por API) trabalhando juntos num projeto local.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "dist": "npx --yes electron-builder@26 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@vscode/codicons": "0.0.45",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.57.0"
  },
  "author": "Lucas Lessa",
  "homepage": "https://github.com/dev-lucccaslp/orbion-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-lucccaslp/orbion-ai.git"
  },
  "build": {
    "appId": "ai.orbion.app",
    "productName": "Orbion.ai",
    "copyright": "Orbion.ai",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/tela/marca/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/tela/marca/orbion.ico",
      "artifactName": "Orbion.ai-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Orbion.ai",
      "uninstallDisplayName": "Orbion.ai",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "src/tela/marca/orbion-app-icon-1024.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Orbion.ai-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/tela/marca/orbion-app-icon-1024.png",
      "category": "Development",
      "maintainer": "Lucas Lessa",
      "synopsis": "Times de IAs trabalhando juntos no teu projeto",
      "artifactName": "Orbion.ai-linux-x64.${ext}"
    }
  }
}
